# Copie para .env.producao NA VPS e preencha lá. Este arquivo de exemplo vai para o git; o .env.producao nunca.

# IA da Lia (formato OpenAI). Groq é o provedor que a equipe usa hoje.
IA_PROVEDOR=groq
IA_MODELO=openai/gpt-oss-120b
IA_CHAVE=
# Chamadas por dia para todo mundo que usa o servidor. Cada mensagem gasta de 2 a 3. Ao acabar, a Lia segue pelas regras.
IA_LIMITE_DIARIO=300

# Banco dos relatos e das contas (Supabase, esquema datempo). Sem estas duas, os relatos ficam em memória e a conta não funciona.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 1 sobe o feed com a cena de demonstração (relatos marcados como demonstração). Para a banca, deixe 0.
DEMO_RELATOS=0
